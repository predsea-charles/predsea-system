FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgeos-dev libproj-dev proj-bin libnetcdf-dev libhdf5-dev \
    libeccodes-tools ca-certificates curl awscli \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app:/app/humanintheloop
WORKDIR /app
COPY requirements-aws.txt .
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements-aws.txt
COPY . .
RUN mkdir -p /app/simulation/inputs && cp /app/assets/static_grids/balearic_bathymetry_*.nc /app/simulation/inputs/
EXPOSE 8080
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8080", "--app-dir", "humanintheloop"]
