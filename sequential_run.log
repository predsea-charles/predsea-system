        imageUri: europe-west1-docker.pkg.dev/predsea-api/predsea-simulations/ww3-batch:latest
        options: --shm-size=16g
      environment:
        variables:
          OMPI_ALLOW_RUN_AS_ROOT: '1'
          OMPI_ALLOW_RUN_AS_ROOT_CONFIRM: '1'
