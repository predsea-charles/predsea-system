# WW3 (WAVEWATCH III) batch image -- Phase 0 of the WW3 migration
# (docs/ww3-migration-plan-2026-08-04.md). Replaces the SWAN builder stage in
# simulation/marine/croco/Dockerfile.batch with a WW3 equivalent, reusing the
# same CROCO builder stage and final runtime pattern from that file so the
# rest of the pipeline (GCS layout, run_marine_simulation.py, BigQuery
# ingestion) needs no changes beyond a new --model=ww3 code path.
#
# Build mechanism verified directly against the live NOAA-EMC/WW3 develop
# branch source on 2026-08-04 (its CMakeLists.txt confirms the
# `-DSWITCH=<path>` flag). The switch file token composition
# (simulation/marine/ww3/switch_predsea) is assembled from established WW3
# configuration conventions, not independently re-verified this session --
# see simulation/marine/ww3/switch_predsea.md for the rationale per token
# and the caveat that the first build here is the real validation of it.
#
# NOTE: pinned to the `develop` branch with --depth 1 rather than a tagged
# release, because this session could not reach a live, verified list of
# current release tags/commit SHAs to pin against (network access to
# api.github.com was unavailable in the authoring environment). Before
# relying on this image operationally, replace `--branch develop` below
# with a specific release tag or commit SHA once one has been confirmed
# against the actual NOAA-EMC/WW3 repo, for reproducibility -- the same
# reproducibility guarantee the SWAN/CROCO builder stages get today via a
# pinned version + sha256 checksum.

FROM debian:bookworm-slim AS ww3_builder

ARG WW3_GIT_REF=develop

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git cmake make gfortran gcc g++ \
        libnetcdf-dev libnetcdff-dev \
        openmpi-bin libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# Shallow clone of a single branch -- see the pinning note above. This is a
# git source dependency (an open-source library vendored at build time),
# the same category as SWAN's sourceforge tarball and CROCO's gitlab
# tarball already used elsewhere in this repo's Docker builds -- not a
# deployment/CI dependency on GitHub itself.
RUN git clone --branch "${WW3_GIT_REF}" --depth 1 \
      https://github.com/NOAA-EMC/WW3.git ww3_src

COPY simulation/marine/ww3/switch_predsea /src/switch_predsea

WORKDIR /src/ww3_src
ENV FC=mpif90 CC=mpicc
RUN cmake -S . -B build \
      -DSWITCH=/src/switch_predsea \
      -DCMAKE_BUILD_TYPE=Release \
      -DNETCDF=ON \
    && cmake --build build --parallel 8

# Executable output path verified 2026-08-04 against the live NOAA-EMC/WW3
# develop branch source (model/src/CMakeLists.txt sets
# CMAKE_RUNTIME_OUTPUT_DIRECTORY to ${CMAKE_BINARY_DIR}/bin) -- this was
# actually wrong in the first build attempt here (assumed build/model/exe/,
# which doesn't exist), caught by a real Cloud Build COPY failure and fixed
# by reading the actual CMakeLists.txt rather than guessing again.

FROM debian:bookworm-slim AS croco_builder

ARG CROCO_VERSION=2.1.3
ARG CROCO_SHA256=4b7464365f3e6197ed83b5ae8842cc1efc736add2c86e16a0ff188e7650661c1
ARG PREDSEA_CROCO_LM=499
ARG PREDSEA_CROCO_MM=399
ARG PREDSEA_CROCO_N=32
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gfortran libnetcdf-dev libnetcdff-dev make \
      openmpi-bin libopenmpi-dev python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl --fail --location --retry 4 \
      "https://gitlab.inria.fr/croco-ocean/croco/-/archive/v${CROCO_VERSION}/croco-v${CROCO_VERSION}.tar.gz" \
      --output croco.tar.gz \
    && echo "${CROCO_SHA256}  croco.tar.gz" | sha256sum --check \
    && mkdir -p tmp/croco_build \
    && tar -xzf croco.tar.gz -C tmp/croco_build \
    && mv "tmp/croco_build/croco-v${CROCO_VERSION}" tmp/croco_build/croco_src
COPY simulation/marine/croco/patch_croco_source.py /build/patch_croco_source.py
RUN mkdir -p /usr/local/bin \
    && for region in alboran_1km:499:249 algerian_1km:949:299 balearic_1km:499:399 gulf_of_lion_1km:498:198 tyrrhenian_1km:648:649; do \
         name=$(echo $region | cut -d: -f1); \
         lm=$(echo $region | cut -d: -f2); \
         mm=$(echo $region | cut -d: -f3); \
         echo "Building CROCO binary for $name (LM=$lm, MM=$mm)..."; \
         rm -rf /build/tmp/croco_build/Build /build/tmp/croco_build/Compile; \
         PREDSEA_CROCO_LM=$lm PREDSEA_CROCO_MM=$mm PREDSEA_CROCO_N=32 python3 /build/patch_croco_source.py; \
         cp /build/tmp/croco_build/croco_src/OCEAN/jobcomp /build/tmp/croco_build/jobcomp; \
         chmod 0755 /build/tmp/croco_build/jobcomp; \
         (cd /build/tmp/croco_build && ./jobcomp --src croco_src/OCEAN --jobs 8 && test -x croco && mv croco /usr/local/bin/croco_${name}); \
       done \
    && ln -s /usr/local/bin/croco_balearic_1km /usr/local/bin/croco_balearic

FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libeccodes-tools libgfortran5 libnetcdf19 \
      libnetcdff7 openmpi-bin \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/local/bin/python3 /usr/bin/python3
RUN curl -sSL \
      https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz \
      -o /tmp/google-cloud-sdk.tar.gz \
    && tar -xzf /tmp/google-cloud-sdk.tar.gz -C /opt \
    && /opt/google-cloud-sdk/install.sh --quiet \
    && rm /tmp/google-cloud-sdk.tar.gz
ENV PATH="/opt/google-cloud-sdk/bin:${PATH}" \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
COPY --from=croco_builder /usr/local/bin/croco_* /usr/local/bin/
RUN chmod 0755 /usr/local/bin/croco_*

# WW3 executables -- see the path caveat in the ww3_builder stage above.
COPY --from=ww3_builder /src/ww3_src/build/bin/ww3_grid /usr/local/bin/ww3_grid
COPY --from=ww3_builder /src/ww3_src/build/bin/ww3_prnc /usr/local/bin/ww3_prnc
COPY --from=ww3_builder /src/ww3_src/build/bin/ww3_bounc /usr/local/bin/ww3_bounc
COPY --from=ww3_builder /src/ww3_src/build/bin/ww3_shel /usr/local/bin/ww3_shel
COPY --from=ww3_builder /src/ww3_src/build/bin/ww3_ounf /usr/local/bin/ww3_ounf
RUN chmod 0755 /usr/local/bin/ww3_grid /usr/local/bin/ww3_prnc /usr/local/bin/ww3_bounc \
      /usr/local/bin/ww3_shel /usr/local/bin/ww3_ounf

WORKDIR /app
COPY simulation/marine/swan/requirements.batch.txt /app/requirements.batch.txt
RUN pip install --no-cache-dir -r /app/requirements.batch.txt
COPY scripts /app/scripts
COPY simulation/marine/regions /app/simulation/marine/regions
COPY simulation/marine/croco/croco.in.balearic /app/simulation/marine/croco/croco.in.balearic
COPY simulation/marine/croco/prepare_croco_in.py /app/simulation/marine/croco/prepare_croco_in.py
COPY simulation/marine/ww3/switch_predsea /app/simulation/marine/ww3/switch_predsea

# Phase 0 target regions only (tyrrhenian_1km, balearic_1km) -- bathymetry
# for these still needs to be regenerated in WW3's native grid format via a
# new script analogous to scripts/prepare_bathymetry.py (see
# docs/ww3-migration-plan-2026-08-04.md section 3, "must be built new").
# Not yet included in this image; add COPY lines here once that script
# exists and has produced WW3 grid files for these regions.

RUN mkdir -p /app/simulation/inputs /workspace/inputs /workspace/outputs
RUN test -x /usr/local/bin/croco_balearic \
    && test -x /usr/local/bin/ww3_grid \
    && test -x /usr/local/bin/ww3_prnc \
    && test -x /usr/local/bin/ww3_bounc \
    && test -x /usr/local/bin/ww3_shel \
    && test -x /usr/local/bin/ww3_ounf \
    && python3 -c "import copernicusmarine, netCDF4, numpy, scipy, xarray" \
    && python3 /app/scripts/prepare_croco_bulk_forcing.py --help \
    && python3 /app/scripts/run_marine_simulation.py --help
ENTRYPOINT ["python3", "/app/scripts/run_marine_simulation.py"]
