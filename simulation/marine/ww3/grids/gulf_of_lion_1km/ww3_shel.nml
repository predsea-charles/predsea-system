! Generated by scripts/prepare_ww3_forcing.py for region 'gulf_of_lion_1km'.
! Schema verified against NOAA-EMC/WW3 develop branch model/nml/ww3_shel.nml
! (fetched 2026-08-04).
!
! Phase 0 smoke-test scope: wind forcing only. CURRENTS/WATER_LEVELS are
! left at their documented default ('F' = no forcing) -- this run does not
! exercise ocean-current coupling or wave boundary spectra yet (see this
! script's module docstring). The 66 boundary points declared in this
! region's ww3_grid.nml receive no external spectra in this run; WW3 treats
! undriven active boundary points as zero incoming energy (no swell
! entering from outside), so only locally wind-generated sea state is being
! exercised here. Wave boundary spectra (ww3_bounc) are a Phase 1 addition
! once this smoke test confirms ww3_shel steps forward in time cleanly.

&DOMAIN_NML
  DOMAIN%START  = '20260804 000000'
  DOMAIN%STOP   = '20260804 060000'
/

&INPUT_NML
  INPUT%FORCING%WINDS = 'T'
/

&OUTPUT_TYPE_NML
  TYPE%FIELD%LIST     = 'HS DIR SPR WND DTD FC CFX'
/

&OUTPUT_DATE_NML
  DATE%FIELD%START         = '20260804 000000'
  DATE%FIELD%STRIDE        = '3600'
  DATE%FIELD%STOP          = '20260804 060000'
/

&OUTPUT_PATH_NML
  PATH%GRD_OUT = './'
  PATH%PNT_OUT = './'
  PATH%RST_OUT = './'
/
